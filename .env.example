# ── Окружение docker compose ─────────────────────────────────────────────────
# Скопируйте в .env и подставьте случайные значения:
#   cp .env.example .env
# Сгенерировать секрет: openssl rand -hex 16

# PostgreSQL (в хостовую сеть не публикуется)
POSTGRES_DB=ilalex_vinyl
POSTGRES_USER=ilalex_vinyl
POSTGRES_PASSWORD=

# Пароль read-only роли, под которой публичный API ходит в базу (только SELECT)
API_READER_PASSWORD=

# Порты на хосте (только 127.0.0.1). Поменяйте, если заняты другим проектом.
ADMIN_PORT=8090
API_PORT=3001
