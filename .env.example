# PIN владельца — без него отметки «куплено» менять нельзя
VINYL_PIN=

# Vercel KV / Upstash Redis (подставляются автоматически при подключении
# интеграции в дашборде Vercel). Для локальной разработки скопируйте сюда
# значения из дашборда. Поддерживаются оба варианта именования:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# либо
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
