# ── Админка каталога винила (Laravel + Filament) ─────────────────────────────
# Скопируйте в .env и заполните. APP_KEY сгенерировать:
#   docker compose exec admin php artisan key:generate

APP_NAME="Винил — админка"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# PostgreSQL — хост "db" это сервис compose, наружу он не публикуется
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ilalex_vinyl
DB_USERNAME=ilalex_vinyl
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true, когда сайт отдаётся по HTTPS (прод)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Хеширование паролей (argon2id есть в образе FrankenPHP)
HASH_DRIVER=argon2id
