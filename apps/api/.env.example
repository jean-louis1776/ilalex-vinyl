# ── Публичный API каталога (Fastify) ─────────────────────────────────────────
# Скопируйте в .env. DATABASE_URL использует read-only роль api_reader
# (только SELECT); пароль — из API_READER_PASSWORD в корневом .env.
DATABASE_URL=postgres://api_reader:CHANGE_ME@db:5432/ilalex_vinyl
PORT=3001
HOST=0.0.0.0
# "*" разрешает любой origin (нормально для публичного read-only API),
# либо список доменов через запятую
CORS_ORIGINS=*
